{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/sessmem.py hook-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/sessmem.py hook-end"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/sessmem.py hook-end"
          }
        ]
      }
    ]
  }
}
