{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "\"$(command -v python || command -v python3)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/sessmem.py\" hook-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "\"$(command -v python || command -v python3)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/sessmem.py\" hook-end"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "\"$(command -v python || command -v python3)\" \"${CLAUDE_PLUGIN_ROOT}/hooks/sessmem.py\" hook-end"
          }
        ]
      }
    ]
  }
}
